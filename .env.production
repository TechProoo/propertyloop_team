# ─── API ───────────────────────────────────────────────────
# Production backend. Committed on purpose: it is the same public URL the
# website already ships, and Vite bakes it into the bundle at build time —
# nothing secret can live in a VITE_ variable.
#
# Netlify deploy previews build with this too. A preview runs on a
# *.netlify.app origin that the backend does not allowlist, so sign-in there
# fails CORS until that origin is added via CORS_EXTRA_ORIGINS.
VITE_API_URL=https://propertyloopbackend-production.up.railway.app/api

# Sign-in, refresh and sign-out go through the portal's own origin, which
# Netlify forwards to the API (public/_redirects), so the refresh cookie is
# first-party and survives a reload in Safari.
VITE_AUTH_URL=/api
