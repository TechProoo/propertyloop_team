# Security headers for the staff portal (served by Netlify).
# Mirrors the public website's hardening, plus noindex — this one must NOT be
# found in search results. index.html carries the meta tag as well; this covers
# every other response and anything that fetches the page without running it.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()

# Vite fingerprints these filenames, so a changed file is a changed URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The logo is not content-addressed — keep it short enough that a swapped file
# actually shows up.
/logo.png
  Cache-Control: public, max-age=86400

# Home-screen app: the manifest and its icons, same reasoning as the logo.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
/icons/*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# The notification service worker. Browsers check it for updates, and a
# cached copy would keep an old one running.
/sw.js
  Cache-Control: no-cache
